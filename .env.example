# Copy to .env.local only when you want this machine to sync with Supabase.
# Leave empty to run in local-only mode (data stays in this browser, nothing syncs).
# Never put the service-role key here: everything prefixed VITE_ ends up in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sync is refused unless this is "true", so a preview build can never write to production by accident.
VITE_LT_ALLOW_SYNC=
